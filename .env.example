# Copy this file to .env and fill in the values
# cp .env.example .env
# chmod 600 .env   # secrets — owner-readable only

# --- Required ---

# Postgres password for the `vetly` user.
# Use a 32-char random string in production, not a dev placeholder.
DB_PASSWORD=vetly_dev_password

# Backend JWT signing key.
# Generate in prod: openssl rand -hex 32
SECRET_KEY=change-this-to-a-random-string-in-production

# --- Optional / feature flags ---

# Google Gemini API key (AI-powered vet advice feature).
# Leave blank to disable.
GEMINI_API_KEY=

# Resend transactional email.
# EMAIL_NOTIFICATIONS_ENABLED=true requires RESEND_API_KEY to be set.
EMAIL_NOTIFICATIONS_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=Vetly <noreply@vetly.gr>

# Public URL of the frontend, used for links in transactional emails.
# Dev: http://localhost:3000
# Prod: https://vetly.gr
FRONTEND_URL=http://localhost:3000
