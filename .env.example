# Copy this file to .env and fill in the values
# cp .env.example .env
# chmod 600 .env   # secrets — owner-readable only

# --- Required ---

# Postgres password for the `vetly` user.
# Use a 32-char random string in production, not a dev placeholder.
DB_PASSWORD=vetly_dev_password

# Backend JWT signing key.
# Generate in prod: openssl rand -hex 32
# Production refuses to start with fewer than 32 characters or this placeholder.
SECRET_KEY=change-this-to-a-random-string-in-production

# --- Optional / feature flags ---

# Anthropic Claude API key (AI assistant for vets and owners).
# Leave blank to disable.
ANTHROPIC_API_KEY=
# Model the assistant uses. Default: claude-sonnet-5-5
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Transactional email.
# EMAIL_PROVIDER: smtp | resend | console. console only logs (nothing is sent).
# Left empty: resend if RESEND_API_KEY is set, otherwise console.
# EMAIL_NOTIFICATIONS_ENABLED gates notification emails (appointments, reminders);
# verification and password-reset emails are always sent through the provider.
EMAIL_NOTIFICATIONS_ENABLED=false
EMAIL_PROVIDER=
EMAIL_FROM=Vetly <noreply@vetly.gr>
# Our own SMTP server (EMAIL_PROVIDER=smtp). Production refuses to start without SMTP_HOST.
# SMTP_SECURITY: starttls (port 587) | ssl (port 465) | none (trusted local relay only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURITY=starttls
SMTP_TIMEOUT_SECONDS=10
# Resend (EMAIL_PROVIDER=resend).
RESEND_API_KEY=

# Error monitoring. Empty disables Sentry. Sent without personal data or request bodies.
SENTRY_DSN=

# Vets who can approve new clinic registrations at /vet/admin/verifications.
# Comma-separated emails of already verified vet accounts. Empty: nobody.
ADMIN_EMAILS=

# Public URL of the frontend, used for links in transactional emails.
# Dev: http://localhost:3000
# Prod: https://vetly.gr
FRONTEND_URL=http://localhost:3000
